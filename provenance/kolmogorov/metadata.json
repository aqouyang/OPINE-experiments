  "drag": 0.0,
  "domain": [
    [
      0.0,
      6.283185307179586
    ],
    [
      0.0,
      6.283185307179586
    ]
  ],
  "domain_note": "L=2pi is forced by periodicity of sin(k_f y) with integer k_f, not chosen freely",
  "grid": [
    128,
    128
  ],
  "boundary_conditions": "doubly periodic",
  "solver": "jax_cfd.spectral.equations.NavierStokes2D (pseudospectral)",
  "dealiasing": "2/3-rule (smooth=True)",
