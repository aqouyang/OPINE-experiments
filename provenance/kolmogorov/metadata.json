{
  "paper": "Cleary, Wang & Zaki, arXiv:2512.15470",
  "equation": "d_t omega + u.grad omega = (1/Re) lap(omega) - k_f cos(k_f y)",
  "reynolds_number": 100.0,
  "viscosity_1_over_Re": 0.01,
  "forcing_wavenumber_k_f": 4,
