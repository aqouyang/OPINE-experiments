  "ic_max_velocity": 7.0,
  "ic_peak_wavenumber": 4,
  "seed_convention": "trajectory i uses PRNGKey(0 + i)",
  "seed_base": 0,
  "solver_precision": "float64",
  "storage_dtype": "float32",
  "stored_quantity": "out-of-plane vorticity omega(x, y)",
  "dissipation_definition": "D = <omega^2>/Re, stored per snapshot in diag_XXX.npz",
  "resampling": "none; raw uniform time sampling",
  "advective_stable_dt_at_max_speed_10": 0.002454369260617026,
  "versions": {
    "jax": "0.10.2",
